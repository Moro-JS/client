{
  "name": "@morojs/client",
  "version": "0.1.0",
  "description": "The MoroJS client SDK — browser-first and zero-dependency. Ships a socket.io-client-compatible realtime client for the native engine; typed HTTP and shared types are on the roadmap.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "morojs",
    "moro",
    "websocket",
    "ws",
    "realtime",
    "socket",
    "client",
    "browser",
    "engine",
    "react"
  ],
  "author": "Moro Framework Team",
  "license": "MIT",
  "homepage": "https://morojs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moro-JS/client.git"
  },
  "bugs": {
    "url": "https://github.com/Moro-JS/client/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
